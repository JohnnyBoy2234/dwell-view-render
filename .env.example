# Google Maps Places API Configuration
# Get your API key from Google Cloud Console:
# 1. Go to https://console.cloud.google.com/
# 2. Enable Places API and Maps JavaScript API
# 3. Create credentials > API Key
# 4. Restrict by HTTP referrers and APIs for security
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Supabase Configuration
# Backend / edge-function secrets:
SUPABASE_URL=your_supabase_url
SUPABASE_ANON_KEY=your_supabase_anon_key
# Frontend (Vite) — REQUIRED by the apps; the client throws if either is missing.
# Publishable = the project's anon/publishable key. For local dev, get both from
# `npm run supabase -- status` and point them at http://127.0.0.1:54321.
VITE_SUPABASE_URL=your_supabase_url
VITE_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Cross-app handoff targets (production). When a user signs into the wrong app,
# web redirects to the sibling app's URL; if unset (local/dev) or on native, the
# in-app "Wrong App" screen is shown instead.
VITE_TENANT_APP_URL=https://your-tenant-app-url
VITE_LANDLORD_APP_URL=https://your-landlord-app-url

# Example API keys for other services
RESEND_API_KEY=your_resend_api_key_here

# Signing Provider Flags
# Frontend flag to choose provider: legacy | docusign
VITE_SIGN_PROVIDER=legacy
# Force legacy behavior regardless of defaults
VITE_SIGN_PROVIDER_FORCE_LEGACY=false

# DocuSign API Configuration (Frontend-exposed placeholders when needed)
VITE_DOCUSIGN_INTEGRATION_KEY=your_docusign_integration_key_here
VITE_DOCUSIGN_SECRET_KEY=your_docusign_secret_key_here
VITE_DOCUSIGN_ACCOUNT_ID=your_docusign_account_id_here
VITE_DOCUSIGN_BASE_PATH=https://demo.docusign.net/restapi

# Paystack Configuration (test mode)
# Public key from Paystack dashboard (test mode). Used by the frontend to
# detect test mode (TEST MODE badges) — key starting with pk_test enables them.
VITE_PAYSTACK_PUBLIC_KEY=pk_test_xxx

# Google Maps / Places — powers address autocomplete (add-property) and the
# tenant area-search suggestions. Enable "Places API" + "Maps JavaScript API"
# on the key in Google Cloud. Baked in at BUILD time (Vite), so set it in each
# app's .env locally AND in CI (Codemagic mzanzihomes_env group / Vercel env) —
# it is NOT read from Supabase. If the key is referrer-restricted, allow the
# native app origins capacitor://localhost and https://localhost.
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# OCR.space (rental-application document text extraction — supabase/functions/ocr-process)
# These are Edge Function secrets, NOT frontend vars — never prefix with VITE_.
# Set them with `supabase secrets set OCR_SPACE_API_KEY=...` (remote) or in
# supabase/functions/.env (gitignored) for `supabase functions serve` locally.
OCR_SPACE_API_KEY=
OCR_SPACE_API_URL=https://api.ocr.space/parse/image
OCR_SPACE_TIMEOUT_MS=45000
OCR_MAX_FILE_SIZE_MB=10
OCR_INCLUDE_RAW_RESPONSE=false
OCR_DEFAULT_LANGUAGE=eng
OCR_DEFAULT_OVERLAY=false